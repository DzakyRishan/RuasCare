# Keep text files consistent across Windows, macOS, and Linux.
* text=auto
*.dart text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.bat text eol=crlf

# Binary assets and wrappers
*.png binary
*.jar binary
