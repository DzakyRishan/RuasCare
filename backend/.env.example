# Copy these values into your terminal environment before running the backend.
# Do not commit an actual .env file or production credentials.
DB_URL=jdbc:postgresql://localhost:5432/lapor_jalan_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgresql-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
SHOW_SQL=false
# Directory for local report-photo files. This directory is ignored by Git.
UPLOAD_DIR=uploads